# Planning happens offline. The provider is given static fake credentials and told
# not to validate them, not to ask STS for an account id and not to reach the
# instance metadata endpoint, so `terraform plan` describes the intended
# infrastructure without an AWS account existing anywhere.
terraform {
  required_version = ">= 1.5"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region                      = "eu-central-1"
  access_key                  = "mock_access_key"
  secret_key                  = "mock_secret_key"
  skip_credentials_validation = true
  skip_requesting_account_id  = true
  skip_metadata_api_check     = true
  skip_region_validation      = true
}
